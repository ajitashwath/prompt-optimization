# ─── LLM Provider API Keys ──────────────────────────────────────────────────
# At least one of these must be set. litellm routes based on the model prefix.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# ─── Model Selection ────────────────────────────────────────────────────────
# The model being optimized (the "optimizee")
OPTIMIZEE_MODEL=openai/gpt-4o-mini

# The model used for judging (ideally a different family than the optimizee)
JUDGE_MODEL=anthropic/claude-3-5-sonnet-20241022

# The model used as the optimizer's proposer (instruction rewriting)
PROPOSER_MODEL=openai/gpt-4o

# The model used for embeddings (dedup + similarity)
EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Storage ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/prompt_opt.db
BLOB_STORE_PATH=./data/blobs

# ─── Optimizer Budget Defaults ───────────────────────────────────────────────
MAX_LLM_CALLS_PER_RUN=500
MAX_WALL_SECONDS_PER_RUN=3600
MAX_USD_SPEND_PER_RUN=10.0

# ─── Gate Thresholds ────────────────────────────────────────────────────────
GATE_MIN_WIN_RATE=0.55
GATE_CI_LEVEL=0.95
GATE_MAX_GUARDRAIL_REGRESSION_PCT=0.05

# ─── Deduplication ──────────────────────────────────────────────────────────
DEDUP_COSINE_THRESHOLD=0.95

# ─── Judge Calibration Thresholds ───────────────────────────────────────────
CALIBRATION_MIN_KAPPA=0.6
CALIBRATION_MIN_CORRELATION=0.7

# ─── Deployment ─────────────────────────────────────────────────────────────
CANARY_INITIAL_PCT=1
CANARY_SOAK_SECONDS=3600
SHADOW_LOG_PATH=./data/shadow_logs

# ─── Feedback Loop ──────────────────────────────────────────────────────────
DRIFT_KL_THRESHOLD=0.1
REINGEST_CRON=0 2 * * *
REOPTIMIZE_CRON=0 3 * * 1

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
